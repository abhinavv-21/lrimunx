# ---------------------------------------------------------------------------
# LRI MUN X Operations Hub — environment contract
# Copy to .env and fill in. The backend refuses to start if any required
# variable is missing or left at an example value.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://munx:munx@localhost:5432/lri_mun_x?schema=public"

# --- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-48-byte-random-string"
JWT_REFRESH_SECRET="replace-me-with-a-different-48-byte-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Server ----------------------------------------------------------------
PORT=4000
NODE_ENV="development"

# Reverse proxies in front of this process. 0 = none, and X-Forwarded-For is
# ignored (the safe default: otherwise a caller can forge their own IP and reset
# the registration rate limiter at will). Set to 1 on Vercel or behind nginx.
TRUST_PROXY=0

# Attach exception messages and stack traces to 5xx responses. Never enable in
# production — it discloses file paths and driver internals to whoever hit the
# error. Off unless you explicitly ask for it.
EXPOSE_ERROR_DETAILS="false"
# Comma-separated allow-list. 5173 is the ops hub, 5174 is the public
# conference website, which posts the registration form to /public/register.
# Add the deployed origins here when you deploy — no code change is needed.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# --- Serving the built site and hub ---------------------------------------
# Leave false for local development, where Vite serves both front ends on their
# own ports. Set it to true on a server: the API process then also serves the
# public site at /, the registration page at /register and the ops hub at
# /admin, so one process on one port is the whole deployment.
#
# Requires a build first — `npm run build` writes the composed tree to ./dist.
SERVE_STATIC="false"
# Where that tree is. Defaults to <repository root>/dist; set it only if you
# deploy the build somewhere else.
# STATIC_DIR="/srv/lrimunx/dist"

# --- Google Sheets / Forms ingestion --------------------------------------
# Shared secret the Apps Script webhook must send as X-Webhook-Secret.
GOOGLE_SHEETS_WEBHOOK_SECRET="replace-me-with-a-random-string"

# --- Web Push (VAPID) ------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@lrimunx.org"

# --- Object storage (payment screenshots) ----------------------------------
# S3-compatible rather than tied to one vendor: Supabase today, R2 or MinIO
# later, same four values and no code change. See apps/backend/src/lib/storage.ts.
#
# Leave empty locally. /api/v1/public/blob-upload then answers 503, the form says
# so, and registration still works without a screenshot — a supported state.
#
# The bucket MUST be private. Payment screenshots are transaction records; they
# are readable only through a signed URL, which only an authenticated ops-hub
# user can obtain (GET /api/v1/registrations/:id/payment-proof).
#
# Include the provider's S3 path prefix where it has one:
#   Supabase  https://<project>.supabase.co/storage/v1/s3
#   R2        https://<account>.r2.cloudflarestorage.com
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# SigV4 puts a region in every signature even where the provider ignores it.
# Supabase publishes one per project; R2 and MinIO accept "auto".
S3_REGION="auto"

# --- Outbound email (approval confirmations) -------------------------------
# Plain SMTP, so the conference's own mailbox works with an app password and
# Resend/SendGrid/Mailgun/Postmark all drop in later by changing these alone.
#
# Leave empty and approving a registration still works — the delegate is created
# and the hub says plainly that no confirmation was sent, rather than claiming
# one was.
#
# Gmail or Google Workspace: smtp.gmail.com, port 587, and an APP PASSWORD from
# the Google account's security page. A normal account password will not work
# and 2FA must be on to generate one.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
# "true" only for port 465 (implicit TLS). Port 587 upgrades with STARTTLS.
SMTP_SECURE="false"
# What the applicant sees in the From line. Most providers refuse to send unless
# the address matches the authenticated mailbox.
SMTP_FROM="LRI MUN X <mun@example.org>"
# Optional — where replies land, if not the sending mailbox.
SMTP_REPLY_TO=""

# --- Seed ------------------------------------------------------------------
# Used only by `npm run seed`. Change before seeding anything shared.
SEED_ADMIN_USERNAME="secretariat"
SEED_ADMIN_PASSWORD="ChangeMe!MUNX2026"
SEED_CONTRIBUTOR_USERNAME="volunteer"
SEED_CONTRIBUTOR_PASSWORD="ChangeMe!MUNX2026"

# --- Frontend (Vite) -------------------------------------------------------
# Vite only exposes VITE_-prefixed variables to the client bundle.
VITE_API_BASE_URL="http://localhost:4000/api/v1"
VITE_VAPID_PUBLIC_KEY=""

# --- Danger zone -----------------------------------------------------------
# Passphrase required, on top of an ADMIN token, to wipe all conference data
# (committees, delegates, registrations, logistics, awards). Accounts, the audit
# log and settings are never touched. Leave empty to disable the feature.
DANGER_RESET_PASSPHRASE=""
