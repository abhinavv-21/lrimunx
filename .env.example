# ---------------------------------------------------------------------------
# LRI MUN X Operations Hub — environment contract
# Copy to .env and fill in. The backend refuses to start if any required
# variable is missing or left at an example value.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://munx:munx@localhost:5432/lri_mun_x?schema=public"

# --- Auth ------------------------------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="replace-me-with-a-48-byte-random-string"
JWT_REFRESH_SECRET="replace-me-with-a-different-48-byte-random-string"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# --- Server ----------------------------------------------------------------
PORT=4000
NODE_ENV="development"

# Reverse proxies in front of this process. 0 = none, and X-Forwarded-For is
# ignored (the safe default: otherwise a caller can forge their own IP and reset
# the registration rate limiter at will). Set to 1 on Vercel or behind nginx.
TRUST_PROXY=0

# Attach exception messages and stack traces to 5xx responses. Never enable in
# production — it discloses file paths and driver internals to whoever hit the
# error. Off unless you explicitly ask for it.
EXPOSE_ERROR_DETAILS="false"
# Comma-separated allow-list. 5173 is the ops hub, 5174 is the public
# conference website, which posts the registration form to /public/register.
# Add the deployed origins here when you deploy — no code change is needed.
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# --- Google Sheets / Forms ingestion --------------------------------------
# Shared secret the Apps Script webhook must send as X-Webhook-Secret.
GOOGLE_SHEETS_WEBHOOK_SECRET="replace-me-with-a-random-string"

# --- Web Push (VAPID) ------------------------------------------------------
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:ops@lrimunx.org"

# --- Vercel Blob (payment screenshots) -------------------------------------
# All injected automatically once a Blob store is linked to the Vercel project.
# Leave them empty locally: /api/v1/public/blob-upload then answers 503 and the
# registration form works without a screenshot.
#
# A store created today authenticates by OIDC — BLOB_STORE_ID plus the runtime's
# own VERCEL_OIDC_TOKEN — and BLOB_READ_WRITE_TOKEN stays empty. Older stores do
# the reverse. Either is enough; the SDK uses whichever is there.
BLOB_STORE_ID=""
BLOB_WEBHOOK_PUBLIC_KEY=""
BLOB_READ_WRITE_TOKEN=""

# Whether the store serves objects to anyone holding the URL.
#
# `private` — the default and what this conference uses. Payment screenshots are
# transaction records; they live on <store>.private.blob.vercel-storage.com and
# are unreadable without a signed URL, which only an authenticated ops-hub user
# can obtain (GET /api/v1/registrations/:id/payment-proof).
#
# Set to `public` ONLY against a store actually created public. The two serve
# from different hosts, and the check that decides whether a submitted URL
# belongs to us keys off this value.
BLOB_ACCESS="private"

# --- Seed ------------------------------------------------------------------
# Used only by `npm run seed`. Change before seeding anything shared.
SEED_ADMIN_USERNAME="secretariat"
SEED_ADMIN_PASSWORD="ChangeMe!MUNX2026"
SEED_CONTRIBUTOR_USERNAME="volunteer"
SEED_CONTRIBUTOR_PASSWORD="ChangeMe!MUNX2026"

# --- Frontend (Vite) -------------------------------------------------------
# Vite only exposes VITE_-prefixed variables to the client bundle.
VITE_API_BASE_URL="http://localhost:4000/api/v1"
VITE_VAPID_PUBLIC_KEY=""

# --- Danger zone -----------------------------------------------------------
# Passphrase required, on top of an ADMIN token, to wipe all conference data
# (committees, delegates, registrations, logistics, awards). Accounts, the audit
# log and settings are never touched. Leave empty to disable the feature.
DANGER_RESET_PASSPHRASE=""
