# Development only — Vite loads this for `npm run dev`, never for `npm run build`.
#
# In production the site and the API share one domain, so the built bundle's
# default of a same-origin /api/v1 is correct and needs no configuration. Here
# they are split across ports, so the form needs the full origin.
#
# The API must also list this site's origin in CORS_ORIGIN — see the repo root
# .env.example.
VITE_API_BASE_URL=http://localhost:4000/api/v1
