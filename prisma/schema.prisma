datasource db {
  provider  = "postgresql"
  // Pooled connection for the app. On a serverless host every cold start opens
  // its own connection, so DATABASE_URL points at a pooler there.
  url       = env("DATABASE_URL")
  // Unpooled, for migrations only. `prisma migrate deploy` takes an advisory
  // lock and cannot hold one through a transaction-mode pooler, so it hangs
  // forever against the pooled URL.
  //
  // DIRECT_URL is REQUIRED, and that is Prisma's behaviour rather than a
  // choice made here: with the variable unset, every CLI command fails with
  // P1012 "Environment variable not found: DIRECT_URL", and setting it to an
  // empty string fails with "You must provide a nonempty direct URL". There is
  // no fallback to `url`. Where there is no pooler — Oracle, and any local
  // machine — set DIRECT_URL to exactly the same value as DATABASE_URL.
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  CONTRIBUTOR
}

enum AttendanceStatus {
  ABSENT
  CHECKED_IN
}

enum RequestCategory {
  PLACARD
  STATIONERY
  AWARDS
  LOGISTICS
}

enum RequestStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum RegistrationStatus {
  PENDING
  APPROVED
  REJECTED
}

/// What an applicant was charged. Four rates, not a free number, because the
/// secretariat has to be able to answer "what did the internal students bring
/// in" at the end without reading every row.
///
/// DISCOUNT is one flat concession rate covering every reason a discount is
/// given — early bird, a school block booking, a hardship case. Splitting it
/// per reason was considered and dropped: the reason belongs in a conversation,
/// the amount is the only part the books need.
enum PriceTier {
  BASE
  INTERNAL
  ALUMNI
  DISCOUNT
}

/// The outcome of one delegate's allocation email. Absence of a row means
/// nobody has tried yet; SENT is the idempotency guard that stops a second
/// press of the button mailing four hundred students twice.
enum AnnouncementStatus {
  SENT
  FAILED
}

model User {
  id             String         @id @default(uuid())
  username       String         @unique
  passwordHash   String
  fullName       String
  role           Role           @default(CONTRIBUTOR)
  /// May create, edit and delete ACCOUNTS. Deliberately a flag and not a role.
  ///
  /// Managing who can sign in is a different kind of power from running the
  /// conference, and the two do not belong on the same axis: an ADMIN allocates
  /// delegates and approves registrations, which is the job; handing out
  /// accounts is not. Adding an OWNER role above ADMIN would have meant
  /// auditing every `role === ADMIN` check in the codebase, and an owner who
  /// silently lost the rest of their admin powers is a worse bug than the one
  /// being fixed.
  ///
  /// Because it is data rather than configuration, it can be granted or revoked
  /// without a deployment — and the routes enforce it, so hiding the tab in the
  /// UI is presentation, not security.
  canManageUsers Boolean        @default(false)
  /// The one person who owns this deployment: settings, the danger zone and the
  /// restart button answer to this and to nothing else.
  ///
  /// A flag rather than `username === 'abhinav'` in the route handlers, for the
  /// same reason canManageUsers is one. A hardcoded name is a deployment away
  /// from being wrong — the handover to next year's secretariat is a rename, a
  /// restored dump can carry a different account, and a test database has no
  /// such user at all. Worse, it scatters the rule across every handler that
  /// checks it, so granting it to a second person means editing code and
  /// shipping. This is a row: `requireOwner` reads it, one migration sets it,
  /// and moving ownership is an UPDATE.
  isOwner        Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  assignments    Assignment[]   @relation("AssignedBy")
  createdReqs    LogisticsReq[] @relation("CreatedBy")
  resolvedReqs   LogisticsReq[] @relation("ResolvedBy")
  auditLogs      AuditLog[]
  subscriptions  PushSub[]
  reviewedRegs   Registration[] @relation("ReviewedBy")
  sessions       Session[]
  ledgerEntries  LedgerEntry[]  @relation("RecordedBy")
}

/// One live sign-in, so that signing out can actually end it.
///
/// Refresh tokens used to be purely stateless: the server checked the signature
/// and the expiry and asked nothing else, which meant it had no way to say no to
/// one it had already issued. Signing out cleared the browser and nothing more,
/// so a copy taken from a shared school machine kept minting access tokens for
/// the rest of its lifetime and there was no way to stop it — not by signing
/// out, not by changing the password.
///
/// The token itself is never stored. `tokenHash` is a SHA-256 of it, so this
/// table cannot be read back into a working credential, and it is the lookup
/// key rather than the id because that is what arrives on the request.
model Session {
  id         String    @id @default(uuid())
  userId     String
  /// SHA-256 (hex) of the refresh token. Never the token.
  tokenHash  String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Copied from the token's own exp, so expired rows can be swept.
  expiresAt  DateTime
  /// Set when the session is ended — by signing out, or by being rotated away.
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Delegate {
  id                   String                  @id @default(uuid())
  fullName             String
  email                String                  @unique
  phone                String
  schoolName           String
  grade                String
  /// What the delegate asked for on the registration form, as they typed it.
  /// Free text rather than a Committee relation on purpose: a form answer is
  /// a wish, not a placement, and it frequently names a committee that does
  /// not exist or is spelled differently. Read only on the Allocations screen.
  committeePreference  String?
  /// The fallback the applicant named when their first choice is full. Same
  /// free-text reasoning as above; it is what makes a reallocation a decision
  /// rather than a guess.
  committeePreference2 String?
  /// Prior MUN experience, carried over from the registration form. The
  /// secretariat weighs it when deciding which room a delegate goes into —
  /// a first-timer in UNSC and a veteran in an unmoderated caucus are both
  /// mistakes that are only visible if the numbers are on the screen.
  munsAttended         Int?
  awardsWon            Int?
  dietaryNotes         String?
  accessibilityNotes   String?
  /// Whether this delegate turned up AT ALL, across the three days.
  ///
  /// No longer the source of truth — DelegateAttendance is, one row per day —
  /// but kept and maintained because "has this person appeared yet" is the
  /// question the delegates list, the exports and the dashboard count ask, and
  /// answering it from three rows per delegate would mean a join on every one
  /// of them. The attendance routes rewrite this whenever a day changes, so it
  /// is CHECKED_IN exactly when at least one day is.
  attendanceStatus     AttendanceStatus        @default(ABSENT)
  attendance           DelegateAttendance[]
  announcement         AllocationAnnouncement?
  assignment           Assignment?
  awards               Award[]
  registration         Registration?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
}

/// A registration submitted from the public conference site.
///
/// Deliberately a separate model from Delegate rather than a Delegate with a
/// status flag: an application is a claim by a member of the public, and a
/// Delegate is a person the OC has accepted. Approval is what turns one into
/// the other, and nothing on this table ever produces a User — the only way
/// into the ops hub is an account an admin creates.
///
/// `email` is intentionally NOT unique. A rejected applicant may legitimately
/// reapply, and a school secretary can submit for two students from one inbox.
/// The duplicate rule that matters — one live application per address — is a
/// PENDING/APPROVED lookup in the route, not a database constraint.
///
/// `submittedIp` and `userAgent` exist for abuse review after the fact, since
/// the endpoint is unauthenticated and rate limiting only sees one instance.
model Registration {
  id                   String             @id @default(uuid())
  /// Human-quotable handle an applicant can read down the phone. LMX-XXXXXX.
  reference            String             @unique
  fullName             String
  email                String
  phone                String
  schoolName           String
  grade                String
  committeePreference  String?
  committeePreference2 String?
  munsAttended         Int?
  awardsWon            Int?
  /// Free text from the "who told you about LRI MUN X" question. Never a
  /// relation: it is whatever the applicant typed, including a name nobody on
  /// the OC recognises.
  referralCode         String?
  /// Which code the free text above was matched to, if any.
  ///
  /// Both are kept on purpose. `referralCode` is what the applicant typed and is
  /// evidence; this is the interpretation, produced by normalising that text and
  /// looking it up. When the two disagree the typed text is the one that is true,
  /// and someone has mistyped a code or a code was created after they applied.
  ///
  /// SetNull rather than Cascade: deleting a referral code must not delete the
  /// registrations that used it.
  referralCodeId       String?
  referralCodeRef      ReferralCode?      @relation(fields: [referralCodeId], references: [id], onDelete: SetNull)
  /// Where the applicant's payment screenshot landed on Vercel Blob. The file
  /// goes browser → blob store directly, so this column is the only record the
  /// API holds of it. Validated against the blob host on the way in — an
  /// arbitrary URL here is a link an admin clicks from the review queue.
  paymentProofUrl      String?
  dietaryNotes         String?
  accessibilityNotes   String?
  status               RegistrationStatus @default(PENDING)
  /// Which of the four rates this applicant was put on. Null until someone on
  /// the secretariat has looked at the screenshot and recorded the payment.
  priceTier            PriceTier?
  /// What actually arrived, in WHOLE NEPALI RUPEES. Not paisa: every rate the
  /// conference charges is a round rupee figure, and minor units would mean
  /// every screen dividing by 100 to show a number nobody writes with decimals.
  ///
  /// Deliberately stored rather than derived from the tier's configured price.
  /// A tier says what was asked for; this says what came in, and the two differ
  /// often enough — a bank transfer rounded down, a part payment, a delegate
  /// who paid last year's rate — that deriving it would erase the real number
  /// the books have to balance against.
  amountPaid           Int?
  reviewedById         String?
  reviewedAt           DateTime?
  rejectionReason      String?
  delegateId           String?            @unique
  submittedIp          String?
  userAgent            String?
  reviewedBy           User?              @relation("ReviewedBy", fields: [reviewedById], references: [id])
  delegate             Delegate?          @relation(fields: [delegateId], references: [id])
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@index([priceTier])
  @@index([referralCodeId])
}

model Committee {
  id            String             @id @default(uuid())
  name          String             @unique // e.g. UNSC, DISEC, UNHRC
  totalSeats    Int
  code          String             @unique
  /// Where this committee's background guide lives. Per committee rather than
  /// one link for the conference because that is what a study guide is: UNSC's
  /// guide is no use to a delegate in ECOFIN, and a single link would send
  /// every delegate to a page they have to search.
  ///
  /// Null until the chairs have written one. The allocation announcement
  /// refuses to send to a committee with no guide rather than mailing a
  /// delegate a link that goes nowhere.
  studyGuideUrl String?
  assignments   Assignment[]
  requests      LogisticsReq[]
  awards        Award[]
  countries     CommitteeCountry[]
}

/// One country on one committee's matrix — the list of who is IN the room,
/// which is a different fact from who has been allocated to it.
///
/// Until this existed, `Assignment.country` was free text: the system could
/// tell you a country was taken but not whether it was ever on offer, so
/// "Fance" saved cleanly and surfaced as a placard.
///
/// Deliberately NOT merged into Assignment. A matrix is authored before any
/// delegate is placed and outlives every allocation — clearing an assignment
/// must free the country, not delete it from the room.
///
/// A committee with no rows here keeps the old free-text behaviour. That is
/// what lets one committee's matrix be imported without freezing the other
/// five, and it is enforced in applyAssignment, not just in the UI.
model CommitteeCountry {
  id          String    @id @default(uuid())
  committeeId String
  country     String
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([committeeId, country])
  @@index([committeeId])
}

model Assignment {
  id           String    @id @default(uuid())
  delegateId   String    @unique
  committeeId  String
  country      String
  assignedById String
  delegate     Delegate  @relation(fields: [delegateId], references: [id], onDelete: Cascade)
  committee    Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  assignedBy   User      @relation("AssignedBy", fields: [assignedById], references: [id])
  updatedAt    DateTime  @updatedAt

  @@unique([committeeId, country])
}

model LogisticsReq {
  id           String          @id @default(uuid())
  title        String
  category     RequestCategory
  description  String
  committeeId  String?
  status       RequestStatus   @default(OPEN)
  /// Which conference day the request is for, 1-3. Filled in from the active
  /// day while the conference is RUNNING and left null before it starts, so a
  /// request raised in October is not pinned to a day nobody has reached yet.
  day          Int?
  createdById  String
  resolvedById String?
  committee    Committee?      @relation(fields: [committeeId], references: [id])
  createdBy    User            @relation("CreatedBy", fields: [createdById], references: [id])
  resolvedBy   User?           @relation("ResolvedBy", fields: [resolvedById], references: [id])
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

/// One award slot in one committee's ceremony.
///
/// `delegateId` is nullable on purpose: the secretariat decides which awards a
/// committee will give long before it knows who wins them, so an award exists
/// as an unfilled slot first. Postgres treats NULLs as distinct in a unique
/// index, so any number of slots can sit unassigned while the composite unique
/// still stops one delegate collecting two awards in the same committee.
///
/// `rank` drives ceremony order — announced last to first — and is derived
/// server-side from the title. Unrecognised (conference-specific) titles fall
/// to the end rather than being rejected.
model Award {
  id          String    @id @default(uuid())
  committeeId String
  title       String
  rank        Int       @default(90)
  delegateId  String?
  note        String?
  committee   Committee @relation(fields: [committeeId], references: [id], onDelete: Cascade)
  delegate    Delegate? @relation(fields: [delegateId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([committeeId, delegateId])
  @@index([committeeId])
}

/// One delegate's attendance on one day of the conference.
///
/// The conference runs 20, 21 and 22 November 2026, and a delegate who came on
/// Saturday and not on Sunday is a fact the old single `attendanceStatus` could
/// not hold: checking someone in on day 2 silently overwrote day 1, so the only
/// honest report the hub could produce was "ever seen".
///
/// A row per day per delegate rather than three columns, so the awards desk can
/// ask "who was here on the day of the ceremony" as a query rather than as
/// three ORs, and so a fourth day costs data instead of a migration.
///
/// ABSENT rows are written as well as CHECKED_IN ones. A missing row and a row
/// saying ABSENT both mean the same thing to a reader, but only the row records
/// that someone actually looked.
model DelegateAttendance {
  id         String           @id @default(uuid())
  delegateId String
  /// 1, 2 or 3. Validated in the API, not by the database: Postgres has no
  /// cheap enum-of-integers, and a CHECK constraint here would have to be
  /// migrated the day the conference gains a day.
  day        Int
  status     AttendanceStatus @default(ABSENT)
  delegate   Delegate         @relation(fields: [delegateId], references: [id], onDelete: Cascade)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([delegateId, day])
  @@index([day, status])
}

/// One line of the conference books.
///
/// The shape a school treasurer already writes: a date, what it was for, and
/// the money in one of two columns. Exactly one of credit/debit is non-zero and
/// the API refuses a row where both or neither are, so a line can never be
/// ambiguous about its direction.
///
/// Registration income is deliberately NOT copied in here. It lives on
/// Registration, where the tier is, and the summary endpoint adds the two
/// together — duplicating it would give the conference two numbers for the same
/// money and no way to tell which one drifted.
/// A code one person hands out, and everyone who used it.
///
/// The point of the table is a number: how many delegates a particular person
/// personally brought in. That number decides a payout, so it has to survive
/// the ways a code actually arrives — typed in lower case, with a space in the
/// middle, with an en dash off a phone keyboard. `code` holds the normalised
/// key produced by lib/referrals.ts and nothing else ever writes to it.
model ReferralCode {
  id            String         @id @default(uuid())
  /// Upper case, no whitespace, one kind of dash. Unique, because two people
  /// cannot share a code and be paid separately for it.
  code          String         @unique
  /// What identity is actually decided on: letters and digits only, so
  /// RIDGE-MUNSOC, RIDGE MUNSOC and ridgemunsoc are one code and not three.
  /// Produced by normaliseReferralCode in lib/referrals.ts.
  matchKey      String         @unique
  /// The person being credited, as they want to be named on a payout.
  ownerName     String
  /// Anything the secretariat needs to remember: which school they are at, how
  /// they are being paid, who approved the code.
  note          String?
  /// A retired code stops matching new registrations. It is not deleted,
  /// because the registrations that already used it still have to count.
  active        Boolean        @default(true)
  registrations Registration[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([ownerName])
}

model LedgerEntry {
  id           String   @id @default(uuid())
  /// When the money moved, which is not when the row was typed. Both matter:
  /// this one closes the books, `createdAt` says who was catching up on what.
  entryDate    DateTime
  particular   String
  /// Where the line belongs in the closing statement, in the treasurer's own
  /// words. Free text and not an enum: a conference always turns up an expense
  /// nobody listed in advance, and a fixed set means every one of them lands in
  /// MISC, which is the same as not categorising it at all. The ten the
  /// secretariat has always used are offered as suggestions in the hub, and the
  /// API folds a new one onto an existing spelling that differs only in case,
  /// so "venue" and "Venue" stay one row in the summary rather than two.
  category     String
  /// Money in and money out, in WHOLE NEPALI RUPEES — the same unit as
  /// Registration.amountPaid, so the two can be added without a conversion.
  credit       Int      @default(0)
  debit        Int      @default(0)
  note         String?
  recordedById String
  recordedBy   User     @relation("RecordedBy", fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([entryDate])
  @@index([category])
}

/// Whether this delegate has been told which committee they are in.
///
/// One row per delegate, unique on the delegate, and that uniqueness is the
/// whole point: the announcement goes to four hundred school students over
/// SMTP in batches of twenty-five, and a duplicate mailshot is not something
/// you can take back. The send skips anyone who already has a SENT row, so
/// pressing the button twice is safe and resuming after a timeout is the
/// normal way it finishes.
///
/// FAILED rows are kept rather than deleted. SMTP rejects a handful of school
/// addresses on every send, and the operator needs to see which ones and why
/// — `attempts` and `error` are what turn "12 failed" into something someone
/// can act on. A retry updates the row in place.
model AllocationAnnouncement {
  id         String             @id @default(uuid())
  delegateId String             @unique
  status     AnnouncementStatus
  /// The SMTP failure, verbatim, on a FAILED row. Null once it succeeds.
  error      String?
  /// Counts every attempt, not just the failures, so a row that took three
  /// goes to get through is visible as one.
  attempts   Int                @default(1)
  sentAt     DateTime?
  delegate   Delegate           @relation(fields: [delegateId], references: [id], onDelete: Cascade)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([status])
}

model AuditLog {
  id            String   @id @default(uuid())
  userId        String
  action        String
  entityType    String
  entityId      String
  payloadBefore Json?
  payloadAfter  Json?
  timestamp     DateTime @default(now())
  user          User     @relation(fields: [userId], references: [id])
}

/// Small key/value store for conference-level configuration entered in the
/// app: the registration form link, the four price tiers, and whether the
/// conference is running and on which day.
///
/// Values are strings even when they are numbers. A typed settings table would
/// mean a migration every time the secretariat wants to configure one more
/// thing, and the four callers that read a number here parse it in one place
/// (lib/conference.ts) with a documented default.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model PushSub {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  keysP256  String
  keysAuth  String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
