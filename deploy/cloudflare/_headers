# Cloudflare Pages response headers — the equivalent of the "headers" block in
# vercel.json, minus the API (which is not served from here).
#
# Indentation is significant: a path pattern at column 0, its headers indented
# beneath it. A blank line ends the block.

# The ops hub is not a public document. It is kept out of search results, and
# out of frames, so a copy of it cannot be dressed up as something else.
/admin/*
  X-Robots-Tag: noindex, nofollow
  X-Frame-Options: DENY
  Referrer-Policy: same-origin

# Fingerprinted bundles — the filename changes whenever the contents do, so
# these can be cached for a year and never revalidated. Both front ends emit
# them under their own assets directory.
/assets/build/*
  Cache-Control: public, max-age=31536000, immutable

/admin/assets/*
  Cache-Control: public, max-age=31536000, immutable
